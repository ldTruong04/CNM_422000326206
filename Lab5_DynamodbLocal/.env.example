# Chỉ dùng DynamoDB Local (Docker) – không kết nối AWS cloud

# Khi chạy app trên host, kết nối DynamoDB Local trong Docker
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1

# Tên bảng
DYNAMODB_TABLE_PRODUCTS=Products

# Port (mặc định 3000)
# PORT=3000

# Ảnh sản phẩm: không set S3_BUCKET thì lưu vào public/uploads (local)
