<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Product</title>
</head>
<body>
  <h1>Edit Product</h1>
  <a href="/">Back</a>

  <% if (error) { %>
  <p><strong>Error:</strong> <%= error %></p>
  <% } %>

  <form action="/edit/<%= product.id %>" method="POST" enctype="multipart/form-data">
    <label>
      Product Name
      <input name="name" value="<%= product.name %>" required />
    </label>

    <label>
      Price
      <input name="price" type="number" min="0" step="0.01" value="<%= product.price %>" required />
    </label>

    <label>
      Unit In Stock
      <input name="unit_in_stock" type="number" min="0" step="1" value="<%= product.unit_in_stock %>" required />
    </label>

    <p>
      <strong>Current Image</strong>
      <% if (product.url_image) { %>
      <br />
      <img src="<%= product.url_image %>" alt="<%= product.name %>" width="100" height="100" />
      <% } else { %>
      <br />
      No image
      <% } %>
    </p>

    <label>
      Change Image
      <input name="image" type="file" accept="image/*" />
    </label>

    <button type="submit">Update Product</button>
    <a href="/">Cancel</a>
  </form>
</body>
</html>