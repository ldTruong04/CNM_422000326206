<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Product</title>
</head>
<body>
  <h1>Add Product</h1>
  <a href="/">Back</a>

  <% if (error) { %>
  <p><strong>Error:</strong> <%= error %></p>
  <% } %>

  <form action="/create" method="POST" enctype="multipart/form-data">
    <label>
      Product Name
      <input name="name" value="<%= formData.name %>" required />
    </label>

    <label>
      Price
      <input name="price" type="number" min="0" step="0.01" value="<%= formData.price %>" required />
    </label>

    <label>
      Unit In Stock
      <input name="unit_in_stock" type="number" min="0" step="1" value="<%= formData.unit_in_stock %>" required />
    </label>

    <label>
      Product Image
      <input name="image" type="file" accept="image/*" required />
    </label>

    <button type="submit">Save Product</button>
    <a href="/">Cancel</a>
  </form>
</body>
</html>