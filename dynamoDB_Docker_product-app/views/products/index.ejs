<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Products</title>
</head>
<body>
  <h1>Product Management</h1>
  <a href="/create">Add Product</a>

  

  <form method="GET" action="/">
    <input type="text" name="q" value="<%= keyword %>" placeholder="Search by product name" />
    <button type="submit">Search</button>
    <a href="/">Clear</a>
  </form>

  <table border="1">
    <thead>
      <tr>
        <th>Image</th>
        <th>Name</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (!products.length) { %>
      <tr>
        <td colspan="5">No products found.</td>
      </tr>
      <% } %>

      <% products.forEach((p) => { %>
      <tr>
        <td>
          <% if (p.url_image) { %>
          <img src="<%= p.url_image %>" alt="<%= p.name %>" width="50" height="50" />
          <% } else { %>
          No image
          <% } %>
        </td>
        <td><%= p.name %></td>
        <td>$<%= Number(p.price || 0).toFixed(2) %></td>
        <td><%= p.unit_in_stock %></td>
        <td>
          <a href="/product/<%= p.id %>">Detail</a>
          <a href="/edit/<%= p.id %>">Edit</a>
          <form method="POST" action="/product/<%= p.id %>?_method=DELETE" onsubmit="return confirm('Delete this product?');" style="display:inline;">
            <button type="submit">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>